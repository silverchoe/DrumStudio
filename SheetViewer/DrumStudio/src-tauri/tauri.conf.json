{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DrumStudio",
  "version": "1.1.1",
  "identifier": "com.drumstudio.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Drum Studio v1.1.1",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: SANG BACK CHOE (86H5G3ZAWS)",
      "entitlements": "Entitlements.plist"
    }
  }
}
